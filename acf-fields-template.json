{
  "_readme": "Import this file via ACF → Tools → Import Field Groups",
  "field_groups": [
    {
      "key": "group_hero_section",
      "title": "Hero Section",
      "fields": [
        {
          "key": "field_hero_title",
          "label": "Hero Title",
          "name": "hero_title",
          "type": "text",
          "default_value": "Aryan Lohia",
          "placeholder": "Your Name"
        },
        {
          "key": "field_hero_role",
          "label": "Hero Role",
          "name": "hero_role",
          "type": "text",
          "default_value": "Event Management & Operations Lead"
        },
        {
          "key": "field_hero_subtitle",
          "label": "Hero Subtitle",
          "name": "hero_subtitle",
          "type": "textarea",
          "default_value": "The behind-the-scenes force who makes your event look effortless.",
          "rows": 2
        },
        {
          "key": "field_hero_description",
          "label": "Hero Description",
          "name": "hero_description",
          "type": "textarea",
          "rows": 4
        },
        {
          "key": "field_hero_image",
          "label": "Hero Image",
          "name": "hero_image",
          "type": "image",
          "return_format": "array",
          "preview_size": "medium"
        }
      ],
      "location": [
        [
          {
            "param": "page_type",
            "operator": "==",
            "value": "front_page"
          }
        ]
      ]
    },
