  "_instructions": [
    "1. Go to WordPress Admin → Plugins → Advanced Custom Fields",
    "2. Click on Tools in the ACF menu",
    "3. Click Import Field Groups",
    "4. Upload this JSON file",
    "5. All field groups will be created automatically",
    "6. Go to Pages → Home → Edit to see and populate the fields"
  ]
